# Google Gemini AI API Key (Required for AI Vision Scanner and EcoBot Chatbot)
# On Vercel: Set in Project Settings > Environment Variables
# On Localhost: Create .env or .env.local file
GEMINI_API_KEY=

# Optional client-side API key for static hosting without serverless functions
VITE_GEMINI_API_KEY=

# Optional: Custom backend URL when running standalone Vite dev server
# VITE_BACKEND_URL=http://localhost:3000

# Firebase & Google Auth (Optional)
FIREBASE_PROJECT_ID=
GOOGLE_WEB_CLIENT_ID=

